{{!
    @template local_aplplot/jqxlabelledgraph

    A Generic graph using JQPlot.

    Example context (json):
    {
        "htmlid": "453215",
        "plotid": "1",
        "addstyle": "",
        "hasticks": true,
        "ticksvalues": "1,2,3,4,5",
        "varsetlist": ""
    }
}}
<!-- local_aplplot/jqp_labelledgraph has_js-->
<div id="{{htmlid}}" class="aplplot-jqmap" style="width:{{width}}px; height:{{height}}px;margin-left:auto;margin-right:auto"></div>
<!-- /local_aplplot/jqp_labelledgraph has_js-->
{{#js}}
$(document).ready(function () {

    {{{rawline}}}

    plot{{plotid}} = $.jqplot(
        '{{htmlid}}',
        [data_{{$htmlid}}], {
            title: '{{title}}',
            seriesDefaults:{
                renderer: $.jqplot.LineRenderer,
                showLine: false,
                showMarker: true,
                shadowAngle: 135,
                markerOptions: {
                    size: 15,
                    style: 'circle'
                },
                shadowDepth: 2
            },
            axes: {
                xaxis: {
                    label: '{{xlabel}}',
                    min: {{xmin}},
                    max: {{xmax}},
                    tickOptions:{
                        formatString: '%d {{xunit}}'
                    }
                },
                yaxis:{
                    label: '{{ylabel}}'
                    min: {{ymin}},
                    max: {{ymax}},
                    tickOptions: {
                        formatString: '%d {{yunit}}'
                    }
                }
            },
            cursor: {
                zoom: true,
                showTooltip: false
            }
        }
    );
});
{{/js}}