{{!
    @template local_aplplot/jqw_simplegauge
    @todo unify variable names with other jq templates

    Simple gauge using JQWidgets.

    Example context (json):
    {
        "name": "mygauge",
        "title": "My gauge",
        "subtitle": null,
        "width": "450",
        "height": "80",
        "top": "0",
        "left": "0",
        "datalist": "10,45,100",
        "max": 100,
        "animation": 3
    }
}}

<!-- local_aplplot/jqw_simplegauge -->
<div class="jqw-gauge-container" style="width:{{width}}px; height:{{height}}px">
    <div id="{{name}}" style="overflow:hidden;position:relative;top:{{top}}px;left:{{left}}px"></div>
</div>
<!-- /local_aplplot/jqw_simplegauge -->
{{#js}}
$(document).ready(function () {
    $('#{{name}}').jqxBarGauge({
        colorScheme: "scheme02",
        width: {{width}},
        height: {{height}},
        {{#title}}
        title: {
            text: '{{title}}'{{#subtitle}},
            subtitle: '{{subtitle}}'{{/subtitle}}
        },
        {{/title}}
        values: [{{datalist}}],
        max: {{max}},
        tooltip: {
            visible: true,
            formatFunction: function (value) {
                var realVal = parseInt(value);
                return (realVal);
            },
        },
        animationDuration: {{animation}}
    });
});
{{/js}}
