{{!
    @template local_aplplot/jqxprogressbar
    @todo unify variable names with other jq templates

    Bar Chart rendering utility template with predefined options.

    Example context (json):
    {
        "name": "Progress",
        "value": "80%",
        "width": "450px",
        "height": "24px",
        "template": "",
        "animation": "5"
    }
}}

<!-- local_aplcore/jqxprogressbar -->
<div style="margin-top: 10px; overflow: hidden;" id="{{name}}" title="{{#str}}completionpercent, local_aplcore, {{value}} {{/str}}"></div>
<!-- /local_aplcore/jqxprogressbar -->
{{#js}}
$(document).ready(function () {
    $("#{{name}}").jqxProgressBar({
        width: "{{width}}",
        height: "{{height}}",
        value: {{value}},
        template: '{{template}}',
        animationDuration: {{animation}}
    });
});
{{/js}}