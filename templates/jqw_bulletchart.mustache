{{!
    @template local_aplplot/jqw_bulletchart
    @todo unify variable names with other jq templates

    Bar Chart rendering utility template with predefined options using JQWidgets.

    Example context (json):
    {
        "id": "564567656",
        "width": "450",
        "height": "350",
        "desc": "",
        "name": "A bar graph",
        "barsize": "20",
        "pointer": [{
            "size": "10%",
            "color": "#000000",
            "opacity": "100",
            "value":"50",
            "label": "Pointer"
        }],
        "tickslabelformat": "",
        "tooltip": "Tooltip",
    }
}}
<!-- local_aplplot/jqw_bulletchart has_js -->
<div id="jqwBulletChart{{id}}" class="jqwidgets-bulletchart"></div>
<!-- /local_aplplot/jqw_bulletchart -->

{{#js}}
$(document).ready(function () {
    $("#jqwBulletChart{{id}}").jqxBulletChart({
        width: "{{width}}",
        height: "{{height}}",
        barSize: "{{barsize}}%",
        title: "{{name}}",
        {{#desc}}description: "{{desc}}",{{/desc}}

        ranges: [
            {{{ranges}}}
        ],

        {{#pointer}}
        pointer: {
            value: {{value}},
            label: "{{label}}",
            size: "{{size}}%",
            color: "{{color}}"
        },
        {{/pointer}}

        {{#target}}
        target: {
            value: {{value}},
            label: "{{label}}",
            size: {{size}}%,
            color: "{{color}}"
        },
        {{/target}}

        {{#ticks}}
        ticks: {
            position: "{{position}}",
            interval: {{interval}},
            size: {{size}}
        }
        {{/ticks}}

        labelsFormat: "{{ticklabelformat}}",
        showTooltip: {{tooltip}}
    });
});
{{/js}}